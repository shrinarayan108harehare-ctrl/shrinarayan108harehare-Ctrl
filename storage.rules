rules_version = '2';

// Reference Firebase Storage Security Rules for large PDF/Video/Prescription media hosting.
// Deploy manually via Firebase CLI (`firebase deploy --only storage`) after enabling Cloud Storage.

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() &&
        firestore.get(/databases/ai-studio-android-prayagde-ec0b0bad-1acf-4ba2-a015-f5baaeff18da/documents/users/$(request.auth.uid)).data.role in ['manager', 'owner'];
    }

    // Customer private prescription & chat media: readable only by owning customer or Managers.
    match /chat_media/{customerId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == customerId || isManager());
      allow write: if isSignedIn() && (request.auth.uid == customerId || isManager())
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Public advertisement promotional banners: readable by signed-in users, writable by Managers only.
    match /advertisements/{fileName} {
      allow read: if isSignedIn();
      allow write: if isManager() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
