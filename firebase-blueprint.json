{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user role binding and notification preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "manager", "owner", "delivery"] },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "linkedManagerId": { "type": "string" },
        "linkedDeliveryPersonId": { "type": "string" },
        "active": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "hi"] },
        "notificationsEnabled": { "type": "boolean" },
        "fcmToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "displayName", "active", "language", "createdAt", "updatedAt"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Customer profile and primary delivery summary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "phoneVerified": { "type": "boolean" },
        "defaultAddressId": { "type": "string" },
        "defaultAddressText": { "type": "string" },
        "defaultLandmark": { "type": "string" },
        "defaultArea": { "type": "string" },
        "defaultLat": { "type": "number" },
        "defaultLng": { "type": "number" },
        "totalOrders": { "type": "integer" },
        "totalSpent": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "phone", "active", "createdAt", "updatedAt"]
    },
    "CustomerAddress": {
      "title": "CustomerAddress",
      "description": "Saved customer delivery address with pinned coordinates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "houseNo": { "type": "string" },
        "street": { "type": "string" },
        "villageOrArea": { "type": "string" },
        "landmark": { "type": "string" },
        "fullAddress": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "primaryAddress": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "label", "villageOrArea", "fullAddress", "lat", "lng", "createdAt", "updatedAt"]
    },
    "ManagerAccount": {
      "title": "ManagerAccount",
      "description": "Individual family manager or owner account with salted password hash.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "mobile": { "type": "string" },
        "roleType": { "type": "string", "enum": ["owner", "family_manager"] },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "authVerificationHash": { "type": "string" },
        "active": { "type": "boolean" },
        "linkedUid": { "type": "string" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "username", "mobile", "roleType", "passwordHash", "passwordSalt", "active", "createdAt", "updatedAt"]
    },
    "DirectoryLookup": {
      "title": "DirectoryLookup",
      "description": "Username-to-account-id and salt lookup without exposing password hashes.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "username": { "type": "string" },
        "salt": { "type": "string" },
        "roleType": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["accountId", "username", "salt", "roleType", "active"]
    },
    "DeliveryPerson": {
      "title": "DeliveryPerson",
      "description": "Individual delivery personnel account.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "username": { "type": "string" },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "authVerificationHash": { "type": "string" },
        "active": { "type": "boolean" },
        "linkedUid": { "type": "string" },
        "onShift": { "type": "boolean" },
        "trackingConsentGranted": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile", "username", "passwordHash", "passwordSalt", "active", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private 1-to-1 WhatsApp-style pharmacy inbox thread per customer.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerArea": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageType": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadByManager": { "type": "integer" },
        "unreadByCustomer": { "type": "integer" },
        "activeOrderId": { "type": "string" },
        "activeOrderStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "customerName", "lastMessage", "lastMessageType", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a private customer-manager conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "customerId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "manager"] },
        "senderName": { "type": "string" },
        "messageType": { "type": "string" },
        "text": { "type": "string" },
        "mediaBase64": { "type": "string" },
        "mediaFileName": { "type": "string" },
        "mediaMimeType": { "type": "string" },
        "mediaDurationSec": { "type": "integer" },
        "orderId": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "prescriptionVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "customerId", "senderUid", "senderRole", "senderName", "messageType", "text", "deliveryStatus", "createdAt"]
    },
    "PharmacyOrder": {
      "title": "PharmacyOrder",
      "description": "Customer and delivery safe order record without confidential cost or profit.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryArea": { "type": "string" },
        "deliveryLandmark": { "type": "string" },
        "deliveryLat": { "type": "number" },
        "deliveryLng": { "type": "number" },
        "locationAccuracyMeters": { "type": "number" },
        "liveLocationShared": { "type": "boolean" },
        "itemsSummary": { "type": "string" },
        "prescriptionRequired": { "type": "boolean" },
        "prescriptionVerified": { "type": "boolean" },
        "verifiedByManagerName": { "type": "string" },
        "quotedBillAmount": { "type": "number" },
        "quotedDeliveryCharge": { "type": "number" },
        "status": { "type": "string" },
        "assignedDeliveryPersonId": { "type": "string" },
        "assignedDeliveryUid": { "type": "string" },
        "assignedDeliveryPersonName": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" },
        "pickedUpAt": { "type": "string", "format": "date-time" },
        "deliveredAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancellationReason": { "type": "string" },
        "deliveryIssue": { "type": "string" },
        "estimatedDistanceKm": { "type": "number" },
        "actualDistanceKm": { "type": "number" },
        "deliveryDurationMinutes": { "type": "integer" },
        "customerRating": { "type": "integer" },
        "customerFeedback": { "type": "string" },
        "lastUpdatedByManagerId": { "type": "string" },
        "lastUpdatedByManagerName": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerId", "customerName", "customerPhone", "deliveryAddress", "deliveryArea", "deliveryLat", "deliveryLng", "status", "createdAt", "updatedAt"]
    },
    "OrderFinancial": {
      "title": "OrderFinancial",
      "description": "Confidential manager-only financial breakdown for an order.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "deliveryArea": { "type": "string" },
        "orderStatus": { "type": "string" },
        "billValue": { "type": "number" },
        "discountAmount": { "type": "number" },
        "refundAmount": { "type": "number" },
        "netProductSales": { "type": "number" },
        "costValue": { "type": "number" },
        "productGrossProfit": { "type": "number" },
        "deliveryDistanceKm": { "type": "number" },
        "deliveryChargeCollected": { "type": "number" },
        "deliveryExpensePaid": { "type": "number" },
        "netBusinessProfit": { "type": "number" },
        "deliveryPersonId": { "type": "string" },
        "deliveryPersonName": { "type": "string" },
        "internalNotes": { "type": "string" },
        "accountingMethod": { "type": "string" },
        "recordedByManagerId": { "type": "string" },
        "recordedByManagerName": { "type": "string" },
        "orderDateKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "customerId", "orderStatus", "billValue", "costValue", "netBusinessProfit", "recordedByManagerId", "recordedByManagerName", "orderDateKey", "createdAt", "updatedAt"]
    },
    "DeliveryAssignment": {
      "title": "DeliveryAssignment",
      "description": "Historical delivery assignment and reassignment log.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "deliveryPersonId": { "type": "string" },
        "deliveryPersonName": { "type": "string" },
        "assignedByManagerId": { "type": "string" },
        "assignedByManagerName": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "deliveryPersonId", "deliveryPersonName", "assignedByManagerId", "status", "createdAt", "updatedAt"]
    },
    "DeliveryLocation": {
      "title": "DeliveryLocation",
      "description": "Consent-gated active shift location for delivery personnel.",
      "type": "object",
      "properties": {
        "deliveryPersonId": { "type": "string" },
        "deliveryPersonName": { "type": "string" },
        "linkedUid": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "trackingActive": { "type": "boolean" },
        "currentStatus": { "type": "string" },
        "activeOrderCount": { "type": "integer" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deliveryPersonId", "deliveryPersonName", "linkedUid", "lat", "lng", "trackingActive", "lastUpdatedAt"]
    },
    "RoutePlan": {
      "title": "RoutePlan",
      "description": "Saved multi-stop delivery route plan.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "deliveryPersonId": { "type": "string" },
        "deliveryPersonName": { "type": "string" },
        "stopOrderIds": { "type": "array" },
        "stopLabels": { "type": "array" },
        "stopLats": { "type": "array" },
        "stopLngs": { "type": "array" },
        "totalEstimatedDistanceKm": { "type": "number" },
        "totalEstimatedMinutes": { "type": "integer" },
        "optimized": { "type": "boolean" },
        "createdByManagerId": { "type": "string" },
        "createdByManagerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "stopOrderIds", "stopLabels", "totalEstimatedDistanceKm", "createdByManagerId", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Broadcast announcement saved permanently in Firestore.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "targetAudience": { "type": "string" },
        "targetUids": { "type": "array" },
        "createdByManagerId": { "type": "string" },
        "createdByManagerName": { "type": "string" },
        "recipientCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "category", "targetAudience", "createdByManagerId", "createdByManagerName", "recipientCount", "createdAt"]
    },
    "RecipientNotification": {
      "title": "RecipientNotification",
      "description": "Per-recipient announcement delivery and read tracking.",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientRole": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "SENT_TO_FCM", "FAILED", "OPENED", "READ"] },
        "failureReason": { "type": "string" },
        "retryCount": { "type": "integer" },
        "createdByManagerName": { "type": "string" },
        "openedAt": { "type": "string", "format": "date-time" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementId", "recipientUid", "recipientName", "title", "message", "status", "createdAt", "updatedAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Promotional banner displayed on the Customer Home ad space.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": { "type": "string" },
        "imagePreset": { "type": "string" },
        "imageBase64": { "type": "string" },
        "linkUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "priority": { "type": "integer" },
        "createdByManagerId": { "type": "string" },
        "createdByManagerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "category", "imagePreset", "active", "createdByManagerId", "createdAt", "updatedAt"]
    },
    "BusinessExpense": {
      "title": "BusinessExpense",
      "description": "Manager-only business operating or delivery expense.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "expenseDateKey": { "type": "string" },
        "notes": { "type": "string" },
        "recordedByManagerId": { "type": "string" },
        "recordedByManagerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "amount", "expenseDateKey", "recordedByManagerId", "recordedByManagerName", "createdAt", "updatedAt"]
    },
    "BusinessSetting": {
      "title": "BusinessSetting",
      "description": "Shop profile, delivery charges, and accounting settings.",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "hours": { "type": "string" },
        "baseDeliveryCharge": { "type": "number" },
        "freeDeliveryAbove": { "type": "number" },
        "shopLat": { "type": "number" },
        "shopLng": { "type": "number" },
        "accountingMethod": { "type": "string" },
        "backupRetentionDays": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopName", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only hash-chained audit trail of manager actions.",
      "type": "object",
      "properties": {
        "managerId": { "type": "string" },
        "managerName": { "type": "string" },
        "actorUid": { "type": "string" },
        "actionPerformed": { "type": "string" },
        "recordType": { "type": "string" },
        "recordId": { "type": "string" },
        "fieldChanged": { "type": "string" },
        "previousValue": { "type": "string" },
        "newValue": { "type": "string" },
        "dateKey": { "type": "string" },
        "timeDisplay": { "type": "string" },
        "actionStatus": { "type": "string" },
        "modificationReason": { "type": "string" },
        "prevHash": { "type": "string" },
        "entryHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["managerId", "managerName", "actorUid", "actionPerformed", "recordType", "recordId", "dateKey", "timeDisplay", "actionStatus", "prevHash", "entryHash", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserAccount" }, "description": "User role binding" },
    "/customers/{customerId}": { "schema": { "$ref": "#/entities/CustomerProfile" }, "description": "Customer profiles" },
    "/customers/{customerId}/addresses/{addressId}": { "schema": { "$ref": "#/entities/CustomerAddress" }, "description": "Customer saved delivery addresses" },
    "/managerDirectory/{username}": { "schema": { "$ref": "#/entities/DirectoryLookup" }, "description": "Manager username lookup" },
    "/managers/{managerId}": { "schema": { "$ref": "#/entities/ManagerAccount" }, "description": "Individual family manager & owner accounts" },
    "/deliveryDirectory/{username}": { "schema": { "$ref": "#/entities/DirectoryLookup" }, "description": "Delivery person username lookup" },
    "/deliveryPersonnel/{dpId}": { "schema": { "$ref": "#/entities/DeliveryPerson" }, "description": "Individual delivery personnel accounts" },
    "/conversations/{conversationId}": { "schema": { "$ref": "#/entities/Conversation" }, "description": "Private customer-manager conversation threads" },
    "/conversations/{conversationId}/messages/{messageId}": { "schema": { "$ref": "#/entities/ChatMessage" }, "description": "Messages inside private customer-manager conversations" },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/PharmacyOrder" }, "description": "Customer and delivery visible pharmacy orders" },
    "/orderFinancials/{orderId}": { "schema": { "$ref": "#/entities/OrderFinancial" }, "description": "Confidential manager-only order financials" },
    "/deliveryAssignments/{assignmentId}": { "schema": { "$ref": "#/entities/DeliveryAssignment" }, "description": "Order assignment history" },
    "/deliveryLocations/{dpId}": { "schema": { "$ref": "#/entities/DeliveryLocation" }, "description": "Live consent-gated delivery GPS location" },
    "/routePlans/{planId}": { "schema": { "$ref": "#/entities/RoutePlan" }, "description": "Multi-stop delivery route plans" },
    "/announcements/{announcementId}": { "schema": { "$ref": "#/entities/Announcement" }, "description": "Manager broadcast announcements" },
    "/notifications/{notificationId}": { "schema": { "$ref": "#/entities/RecipientNotification" }, "description": "Per-recipient announcement inbox and delivery status" },
    "/advertisements/{adId}": { "schema": { "$ref": "#/entities/Advertisement" }, "description": "Promotional banners for customer home screen" },
    "/expenses/{expenseId}": { "schema": { "$ref": "#/entities/BusinessExpense" }, "description": "Manager-only business expenses" },
    "/businessSettings/{settingId}": { "schema": { "$ref": "#/entities/BusinessSetting" }, "description": "Shop and financial configuration" },
    "/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Append-only tamper-evident manager audit logs" }
  }
}
